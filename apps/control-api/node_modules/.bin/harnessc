#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/hariganesh/code/ehfconcept/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/hariganesh/code/ehfconcept/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/npx.exe" ]; then
  exec "$basedir/npx.exe"  tsx "$basedir_win/../@ehf/compiler/src/cli.ts" "$@"
elif [ -x "$basedir/npx" ]; then
  exec "$basedir/npx"  tsx "$basedir/../@ehf/compiler/src/cli.ts" "$@"
elif command -v npx >/dev/null 2>&1; then
  exec npx  tsx "$basedir/../@ehf/compiler/src/cli.ts" "$@"
elif [ -n "$exe" ] && command -v npx.exe >/dev/null 2>&1; then
  exec npx.exe  tsx "$basedir_win/../@ehf/compiler/src/cli.ts" "$@"
else
  exec npx  tsx "$basedir/../@ehf/compiler/src/cli.ts" "$@"
fi
