# Examples only. Do not store real secrets in source control or distribute them.
WIRING_MODE=demo
WORKER_ENABLED=1
# Local development can omit DATABASE_URL, ENCRYPTION_KEY and API_KEYS_JSON in DEMO ONLY.
# Live mode requires all of the following, with real generated values:
DATABASE_URL=
ENCRYPTION_KEY=
API_KEYS_JSON=
POSTGRES_PASSWORD=
# API_KEYS_JSON example shape: {"GENERATED_HOST_TOKEN":{"tenant_id":"your-tenant","role":"admin"}}
# The JSON above contains no upstream vendor credentials.

# Real vendor credential testing is private-only and disabled by default.
VENDOR_TEST_ENABLED=0
VENDOR_TEST_TENANTS_JSON=[]
ENABLE_API_DOCS=0
# Upstream variable names: config/vendor-secrets.env.example
