{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "create": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "skill",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000000
          }
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "save": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000000
          }
        }
      },
      "required": [
        "expectedRevision",
        "message",
        "files"
      ],
      "additionalProperties": false
    },
    "evaluate": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "dataset": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "cases": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "input": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "expected": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "assertions": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 300
                        },
                        "operator": {
                          "type": "string",
                          "enum": [
                            "equals",
                            "contains",
                            "exists"
                          ]
                        },
                        "value": {}
                      },
                      "required": [
                        "path",
                        "operator"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "input"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "name",
            "version",
            "cases"
          ],
          "additionalProperties": false
        },
        "modelProfileId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "maxCostUsd": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "revision",
        "dataset"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "skill",
            "agent"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
        },
        "engine": {
          "type": "string",
          "enum": [
            "python",
            "javascript",
            "library-skill",
            "agent"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "inputSchema": {
          "default": {
            "type": "object"
          },
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "outputSchema": {
          "default": {
            "type": "object"
          },
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "modelProfileId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "skillRefs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "digest"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "engine",
        "entrypoint"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "cases": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "input": {
                "$ref": "#/$defs/__schema0"
              },
              "expected": {
                "$ref": "#/$defs/__schema1"
              },
              "assertions": {
                "default": [],
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "contains",
                        "exists"
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "path",
                    "operator"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "input"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "version",
        "cases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "create",
    "save",
    "evaluate",
    "config",
    "dataset"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
