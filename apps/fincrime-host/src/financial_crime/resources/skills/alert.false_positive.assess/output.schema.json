{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "FindingRow_claim_evidence_ids_status": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "claim": {
          "$ref": "#/$defs/Text"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "id",
        "claim",
        "status",
        "evidence_ids",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "INDICATOR",
        "EXCULPATORY",
        "UNVERIFIED",
        "DISPUTED"
      ]
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:alert.false_positive.assess:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contradictory": {
      "items": {
        "$ref": "#/$defs/FindingRow_claim_evidence_ids_status"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "exculpatory": {
      "items": {
        "$ref": "#/$defs/FindingRow_claim_evidence_ids_status"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "final_clearance": {
      "type": "boolean"
    }
  },
  "required": [
    "exculpatory",
    "contradictory",
    "final_clearance"
  ],
  "type": "object"
}
