{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PaymentAnomaly": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "payment_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "payment_id",
        "amount",
        "currency"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:fraud.payment.anomaly:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anomalies": {
      "items": {
        "$ref": "#/$defs/PaymentAnomaly"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "anomalies"
  ],
  "type": "object"
}
