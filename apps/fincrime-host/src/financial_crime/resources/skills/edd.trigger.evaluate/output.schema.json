{
  "$defs": {
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "TriggerResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        }
      },
      "required": [
        "id",
        "outcome"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:edd.trigger.evaluate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "required": {
      "type": "boolean"
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/TriggerResult"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "triggers",
    "required"
  ],
  "type": "object"
}
