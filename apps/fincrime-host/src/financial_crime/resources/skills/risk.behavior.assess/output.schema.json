{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "RiskFactorResult": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "known": {
          "$ref": "#/$defs/Bool"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "id",
        "factor",
        "value",
        "score",
        "known"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:risk.behavior.assess:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "factors": {
      "items": {
        "$ref": "#/$defs/RiskFactorResult"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "factors"
  ],
  "type": "object"
}
