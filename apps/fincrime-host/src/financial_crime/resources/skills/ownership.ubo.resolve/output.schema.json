{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "OwnershipCalculation": {
      "additionalProperties": false,
      "properties": {
        "cycles": {
          "items": {
            "items": {
              "$ref": "#/$defs/Id"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "interests": {
          "additionalProperties": {
            "$ref": "#/$defs/Decimal"
          },
          "type": "object",
          "x-dynamic-map-reason": "keyed collection"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/OwnershipPath"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "unresolved": {
          "items": {
            "$ref": "#/$defs/OwnershipGap"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "interests",
        "paths",
        "cycles",
        "unresolved"
      ],
      "type": "object"
    },
    "OwnershipGap": {
      "additionalProperties": false,
      "properties": {
        "interest": {
          "$ref": "#/$defs/Decimal"
        },
        "node": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "node",
        "reason"
      ],
      "type": "object"
    },
    "OwnershipPath": {
      "additionalProperties": false,
      "properties": {
        "interest": {
          "$ref": "#/$defs/Decimal"
        },
        "owner": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "owner",
        "path",
        "interest"
      ],
      "type": "object"
    },
    "UboCandidate": {
      "additionalProperties": false,
      "properties": {
        "control_bases": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "entity_id": {
          "$ref": "#/$defs/Id"
        },
        "interest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "entity_id",
        "interest",
        "verified",
        "control_bases"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:ownership.ubo.resolve:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calculation": {
      "$ref": "#/$defs/OwnershipCalculation"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/UboCandidate"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "candidates",
    "calculation"
  ],
  "type": "object"
}
