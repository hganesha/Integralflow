{
  "$defs": {
    "Fraction": {
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:ownership.threshold.evaluate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "qualifying": {
      "items": {
        "$ref": "#/$defs/Id"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "threshold": {
      "$ref": "#/$defs/Fraction"
    }
  },
  "required": [
    "qualifying",
    "threshold"
  ],
  "type": "object"
}
