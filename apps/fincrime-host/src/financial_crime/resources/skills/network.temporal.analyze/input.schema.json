{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "GraphSnapshot": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "$ref": "#/$defs/Bool"
        },
        "edge_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:network.temporal.analyze:input:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/GraphSnapshot"
    },
    "before": {
      "$ref": "#/$defs/GraphSnapshot"
    }
  },
  "required": [
    "before",
    "after"
  ],
  "type": "object"
}
