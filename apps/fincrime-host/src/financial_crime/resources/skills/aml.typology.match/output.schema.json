{
  "$defs": {
    "CountIndicator": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/Id"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "total": {
          "$ref": "#/$defs/Decimal"
        },
        "transaction_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "account",
        "currency",
        "transaction_ids",
        "total",
        "kind"
      ],
      "type": "object"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PathIndicator": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "transaction_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "transaction_ids",
        "kind",
        "currency"
      ],
      "type": "object"
    },
    "ThroughputIndicator": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/Id"
        },
        "allocation": {
          "$ref": "#/$defs/Id"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "transaction_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "account",
        "currency",
        "transaction_ids",
        "kind",
        "allocation"
      ],
      "type": "object"
    },
    "TypologyIndicator": {
      "oneOf": [
        {
          "$ref": "#/$defs/CountIndicator"
        },
        {
          "$ref": "#/$defs/ThroughputIndicator"
        },
        {
          "$ref": "#/$defs/PathIndicator"
        }
      ]
    },
    "TypologyResult": {
      "additionalProperties": false,
      "properties": {
        "indicators": {
          "items": {
            "$ref": "#/$defs/TypologyIndicator"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "typology": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "typology",
        "indicators"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:aml.typology.match:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "not_proof": {
      "type": "boolean"
    },
    "typologies": {
      "items": {
        "$ref": "#/$defs/TypologyResult"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "typologies",
    "not_proof"
  ],
  "type": "object"
}
