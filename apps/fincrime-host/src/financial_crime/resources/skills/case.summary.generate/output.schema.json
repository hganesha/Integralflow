{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "CaseSummary": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/SummaryFinding"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/ContextGap"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "findings",
        "gaps"
      ],
      "type": "object"
    },
    "ContextGap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/Id"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "object_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "code",
        "optional"
      ],
      "type": "object"
    },
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "FindingRow_claim_evidence_ids_status": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "claim": {
          "$ref": "#/$defs/Text"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "id",
        "claim",
        "status",
        "evidence_ids",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "INDICATOR",
        "EXCULPATORY",
        "UNVERIFIED",
        "DISPUTED"
      ]
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "SummaryFinding": {
      "$ref": "#/$defs/FindingRow_claim_evidence_ids_status"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:case.summary.generate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "$ref": "#/$defs/CaseSummary"
    }
  },
  "required": [
    "summary"
  ],
  "type": "object"
}
