{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "IdentityVerification": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/Ref"
        },
        "subject": {
          "$ref": "#/$defs/Id"
        },
        "verified": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "subject",
        "verified",
        "basis"
      ],
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:entity.identity.verify:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "verifications": {
      "items": {
        "$ref": "#/$defs/IdentityVerification"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "verifications"
  ],
  "type": "object"
}
