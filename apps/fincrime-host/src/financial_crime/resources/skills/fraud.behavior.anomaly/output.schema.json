{
  "$defs": {
    "BehaviorAnomaly": {
      "oneOf": [
        {
          "$ref": "#/$defs/BehaviorUnknown"
        },
        {
          "$ref": "#/$defs/BehaviorDeviation"
        }
      ]
    },
    "BehaviorDeviation": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "feature": {
          "$ref": "#/$defs/Id"
        },
        "session_id": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "session_id",
        "feature",
        "value",
        "bounds"
      ],
      "type": "object"
    },
    "BehaviorUnknown": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "$ref": "#/$defs/Id"
        },
        "session_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/UnknownBaseline"
        }
      },
      "required": [
        "session_id",
        "feature",
        "status"
      ],
      "type": "object"
    },
    "Bounds": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "$ref": "#/$defs/Decimal"
        },
        "minimum": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "UnknownBaseline": {
      "const": "UNKNOWN_BASELINE"
    }
  },
  "$id": "urn:financial-crime:skill:fraud.behavior.anomaly:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anomalies": {
      "items": {
        "$ref": "#/$defs/BehaviorAnomaly"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "anomalies"
  ],
  "type": "object"
}
