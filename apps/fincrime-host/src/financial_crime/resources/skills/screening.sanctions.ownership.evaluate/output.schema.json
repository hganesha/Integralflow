{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "OwnershipGap": {
      "additionalProperties": false,
      "properties": {
        "interest": {
          "$ref": "#/$defs/Decimal"
        },
        "node": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "node",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:screening.sanctions.ownership.evaluate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_interest": {
      "$ref": "#/$defs/Decimal"
    },
    "threshold_met": {
      "type": "boolean"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/OwnershipGap"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "aggregate_interest",
    "threshold_met",
    "unresolved"
  ],
  "type": "object"
}
