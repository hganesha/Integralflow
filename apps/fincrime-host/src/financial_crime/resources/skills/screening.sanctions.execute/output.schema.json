{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ListCoverage": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "$ref": "#/$defs/Timestamp"
        },
        "complete": {
          "$ref": "#/$defs/Bool"
        },
        "jurisdictions": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "list_version": {
          "$ref": "#/$defs/Id"
        },
        "pages_complete": {
          "$ref": "#/$defs/Bool"
        },
        "provider": {
          "$ref": "#/$defs/Id"
        },
        "query": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "list_version",
        "complete"
      ],
      "type": "object"
    },
    "MatchFeatures": {
      "additionalProperties": false,
      "properties": {
        "identifier_conflict": {
          "$ref": "#/$defs/Bool"
        },
        "name_score": {
          "$ref": "#/$defs/Probability"
        },
        "score": {
          "$ref": "#/$defs/Probability"
        },
        "shared_identifiers": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "verified_match": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "score",
        "shared_identifiers",
        "identifier_conflict",
        "name_score",
        "verified_match"
      ],
      "type": "object"
    },
    "Probability": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "ScreeningMatch": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/Id"
        },
        "entity_id": {
          "$ref": "#/$defs/Id"
        },
        "entry_id": {
          "$ref": "#/$defs/Id"
        },
        "features": {
          "$ref": "#/$defs/MatchFeatures"
        },
        "list_version": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "entity_id",
        "entry_id",
        "list_version",
        "features",
        "disposition"
      ],
      "type": "object"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:screening.sanctions.execute:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "items": {
        "$ref": "#/$defs/ListCoverage"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/ScreeningMatch"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "universal_clearance": {
      "type": "boolean"
    }
  },
  "required": [
    "hits",
    "coverage",
    "universal_clearance"
  ],
  "type": "object"
}
