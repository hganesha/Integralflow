{
  "$defs": {
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "InvestigationTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "question": {
          "$ref": "#/$defs/Text"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        }
      },
      "required": [
        "id",
        "question",
        "status"
      ],
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:investigation.plan:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "items": {
        "$ref": "#/$defs/InvestigationTask"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "tasks"
  ],
  "type": "object"
}
