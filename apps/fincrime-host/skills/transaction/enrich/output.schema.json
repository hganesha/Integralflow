{
  "$defs": {
    "AccountRow_account_type_entity_id": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "account_type": {
          "$ref": "#/$defs/Id"
