          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "event_id": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "source_account": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountRow_account_type_entity_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TransactionStatus"
        },
        "target": {
          "$ref": "#/$defs/Id"
        },
        "target_account": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountRow_account_type_entity_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "amount",
        "currency",
        "timestamp",
        "event_id",
        "status",
        "_ref",
        "_synthetic",
        "source_account",
        "target_account"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
