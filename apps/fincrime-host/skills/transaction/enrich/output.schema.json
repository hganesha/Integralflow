        "entity_id",
        "account_type",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "EnrichedTransaction": {
