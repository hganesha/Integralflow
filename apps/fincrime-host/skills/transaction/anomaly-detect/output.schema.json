{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "TransactionAnomaly": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "z_score": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "id",
        "z_score"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:transaction.anomaly.detect:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anomalies": {
      "items": {
        "$ref": "#/$defs/TransactionAnomaly"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "calibrated": {
      "type": "boolean"
    }
  },
  "required": [
    "anomalies",
    "calibrated"
  ],
  "type": "object"
}
