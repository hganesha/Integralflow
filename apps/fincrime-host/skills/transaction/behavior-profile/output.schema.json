{
  "$defs": {
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "TransactionProfile": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/Count"
        },
        "source_count": {
          "$ref": "#/$defs/Count"
        },
        "target_count": {
          "$ref": "#/$defs/Count"
        },
        "totals": {
          "additionalProperties": {
            "$ref": "#/$defs/Decimal"
          },
          "type": "object",
          "x-dynamic-map-reason": "keyed collection"
        }
      },
      "required": [
        "count",
        "totals",
        "source_count",
        "target_count"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:transaction.behavior.profile:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/TransactionProfile"
    }
  },
  "required": [
    "profile"
  ],
  "type": "object"
}
