{
  "$defs": {
    "BaselineDeviation": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "$ref": "#/$defs/Decimal"
        },
        "baseline_known": {
          "$ref": "#/$defs/Bool"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "difference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currency",
        "actual",
        "difference",
        "baseline_known"
      ],
      "type": "object"
    },
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:transaction.baseline.compare:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deviations": {
      "items": {
        "$ref": "#/$defs/BaselineDeviation"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "deviations"
  ],
  "type": "object"
}
