{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "RiskContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "$ref": "#/$defs/Decimal"
        },
        "factor": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "weight": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "RiskSnapshot": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "$ref": "#/$defs/RiskContribution"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "model_version": {
          "$ref": "#/$defs/Id"
        },
        "score": {
          "$ref": "#/$defs/Decimal"
        },
        "tier": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:risk.change.detect:input:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/RiskSnapshot"
    },
    "before": {
      "$ref": "#/$defs/RiskSnapshot"
    }
  },
  "required": [
    "before",
    "after"
  ],
  "type": "object"
}
