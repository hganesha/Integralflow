{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "DerivedRiskFactor": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/Text"
        },
        "name": {
          "$ref": "#/$defs/Id"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "name",
        "score",
        "values",
        "basis"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:risk.factors.derive:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "factors": {
      "items": {
        "$ref": "#/$defs/DerivedRiskFactor"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "factors"
  ],
  "type": "object"
}
