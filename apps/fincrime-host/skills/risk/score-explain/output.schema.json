{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "RiskAssessmentRow_contributions_model_version_score": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/RiskContribution"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "model_version": {
          "$ref": "#/$defs/Id"
        },
        "score": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "id",
        "contributions",
        "model_version",
        "score",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "RiskContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "$ref": "#/$defs/Decimal"
        },
        "factor": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        },
        "weight": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:risk.score.explain:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "explanations": {
      "items": {
        "$ref": "#/$defs/RiskAssessmentRow_contributions_model_version_score"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "explanations"
  ],
  "type": "object"
}
