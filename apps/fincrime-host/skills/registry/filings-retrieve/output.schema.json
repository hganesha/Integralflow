{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "FilingKind": {
      "enum": [
        "corporate",
        "regulatory"
      ]
    },
    "FilingRow_artifact_ref_authority_content_hash_filing_kind": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "artifact_ref": {
          "$ref": "#/$defs/Id"
        },
        "authority": {
          "$ref": "#/$defs/Id"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "filing_kind": {
          "$ref": "#/$defs/FilingKind"
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "id",
        "filing_kind",
        "authority",
        "content_hash",
        "artifact_ref",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "Hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:registry.filings.retrieve:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "filings": {
      "items": {
        "$ref": "#/$defs/FilingRow_artifact_ref_authority_content_hash_filing_kind"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "filings"
  ],
  "type": "object"
}
