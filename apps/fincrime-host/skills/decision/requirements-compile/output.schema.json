{
  "$defs": {
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/RuleLeaf"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "any": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "any"
          ],
          "type": "object"
        }
      ]
    },
    "RequirementApplicability": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Outcome"
        },
        "description": {
          "$ref": "#/$defs/Text"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "when": {
          "$ref": "#/$defs/Predicate"
        }
      },
      "required": [
        "id",
        "applicability"
      ],
      "type": "object"
    },
    "RuleLeaf": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "$ref": "#/$defs/RuleOperator"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "type": "object"
    },
    "RuleOperator": {
      "enum": [
        "eq",
        "ne",
        "in",
        "contains",
        "excludes",
        "gte",
        "gt",
        "lte",
        "lt",
        "present"
      ]
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:decision.requirements.compile:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementApplicability"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "requirements"
  ],
  "type": "object"
}
