{
  "$defs": {
    "Hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "properties": {
        "input_hash": {
          "$ref": "#/$defs/Hash"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "rule_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "rule_id",
        "outcome",
        "input_hash"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:decision.rules.evaluate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evaluations": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    }
  },
  "required": [
    "evaluations",
    "outcome"
  ],
  "type": "object"
}
