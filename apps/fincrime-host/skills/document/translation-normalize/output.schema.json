{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PageTranslation": {
      "additionalProperties": false,
      "properties": {
        "document_version": {
          "$ref": "#/$defs/Id"
        },
        "language": {
          "$ref": "#/$defs/Id"
        },
        "page_id": {
          "$ref": "#/$defs/Id"
        },
        "source_ref": {
          "$ref": "#/$defs/Ref"
        },
        "source_text": {
          "$ref": "#/$defs/Text"
        },
        "synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "page_id",
        "document_version",
        "source_ref",
        "source_text",
        "text",
        "language",
        "synthetic"
      ],
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:document.translation.normalize:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "translations": {
      "items": {
        "$ref": "#/$defs/PageTranslation"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "translations"
  ],
  "type": "object"
}
