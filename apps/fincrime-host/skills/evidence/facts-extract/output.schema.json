        "claim",
        "evidence_ids",
        "verification",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "Bool": {
      "type": "boolean"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
