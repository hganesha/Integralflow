{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "NetworkContribution": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "$ref": "#/$defs/Decimal"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "source",
        "target",
        "path",
        "contribution"
      ],
      "type": "object"
    }
  },
  "$id": "urn:financial-crime:skill:network.risk.propagate:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exposures": {
      "items": {
        "$ref": "#/$defs/NetworkContribution"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "final_decision": {
      "type": "boolean"
    }
  },
  "required": [
    "exposures",
    "final_decision"
  ],
  "type": "object"
}
