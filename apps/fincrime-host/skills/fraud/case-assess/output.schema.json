{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Fraction": {
      "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$",
      "type": "string"
    },
    "FraudSignalRow_evidence_ids_kind_model_version_score": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/Id"
        },
        "model_version": {
          "$ref": "#/$defs/Id"
        },
        "score": {
          "$ref": "#/$defs/Fraction"
        }
      },
      "required": [
        "id",
        "score",
        "kind",
        "model_version",
        "evidence_ids",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:fraud.case.assess:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "final": {
      "type": "boolean"
    },
    "recommendation": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/FraudSignalRow_evidence_ids_kind_model_version_score"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "signals",
    "recommendation",
    "final"
  ],
  "type": "object"
}
