{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "DeviceFingerprint": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "$ref": "#/$defs/Id"
        },
        "fingerprint": {
          "$ref": "#/$defs/Hash"
        },
        "synthetic": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "device_id",
        "fingerprint",
        "synthetic"
      ],
      "type": "object"
    },
    "Hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:fraud.device.fingerprint:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fingerprints": {
      "items": {
        "$ref": "#/$defs/DeviceFingerprint"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "fingerprints"
  ],
  "type": "object"
}
