{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object",
      "x-dynamic-map-reason": "schema-selected or source-domain JSON values"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "TimelineEventRow_change_subject_timestamp": {
      "additionalProperties": false,
      "properties": {
        "_ref": {
          "$ref": "#/$defs/Ref"
        },
        "_synthetic": {
          "$ref": "#/$defs/Bool"
        },
        "change": {
          "$ref": "#/$defs/JsonObject"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "subject": {
          "$ref": "#/$defs/Id"
        },
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "id",
        "subject",
        "timestamp",
        "change",
        "_ref",
        "_synthetic"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:skill:investigation.timeline.build:output:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEventRow_change_subject_timestamp"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "timeline"
  ],
  "type": "object"
}
