{
  "$defs": {
    "DetectionRule": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "model_version": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "$ref": "#/$defs/Id"
        },
        "predicate": {
          "$ref": "#/$defs/Predicate"
        },
        "typology_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "name",
        "predicate",
        "typology_ref"
      ],
      "type": "object"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/RuleLeaf"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "any": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "any"
          ],
          "type": "object"
        }
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "RuleLeaf": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "$ref": "#/$defs/RuleOperator"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "type": "object"
    },
    "RuleOperator": {
      "enum": [
        "eq",
        "ne",
        "in",
        "contains",
        "excludes",
        "gte",
        "gt",
        "lte",
        "lt",
        "present"
      ]
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:context:DetectionRule:2.0.0",
  "$ref": "#/$defs/DetectionRule",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
