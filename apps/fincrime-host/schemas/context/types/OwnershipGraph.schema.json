{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "OwnershipGap": {
      "additionalProperties": false,
      "properties": {
        "interest": {
          "$ref": "#/$defs/Decimal"
        },
        "node": {
          "$ref": "#/$defs/Id"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "node",
        "reason"
      ],
      "type": "object"
    },
    "OwnershipGraph": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "$ref": "#/$defs/Bool"
        },
        "edge_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "root_entity_id": {
          "$ref": "#/$defs/Id"
        },
        "unresolved": {
          "items": {
            "$ref": "#/$defs/OwnershipGap"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "root_entity_id",
        "nodes",
        "edge_refs",
        "complete",
        "unresolved"
      ],
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:context:OwnershipGraph:2.0.0",
  "$ref": "#/$defs/OwnershipGraph",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
