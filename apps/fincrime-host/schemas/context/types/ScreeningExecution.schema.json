{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "ListOrMediaType": {
      "enum": [
        "sanctions",
        "pep",
        "watchlist",
        "adverse_media"
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "ScreeningExecution": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "$ref": "#/$defs/Count"
        },
        "dataset_versions": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "list_published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "$ref": "#/$defs/Id"
        },
        "query": {
          "$ref": "#/$defs/Id"
        },
        "query_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "scope": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "screening_type": {
          "$ref": "#/$defs/ListOrMediaType"
        },
        "status": {
          "$ref": "#/$defs/SearchStatus"
        },
        "subject": {
          "$ref": "#/$defs/Id"
        },
        "truncated": {
          "$ref": "#/$defs/Bool"
        }
      },
      "required": [
        "subject",
        "screening_type",
        "provider",
        "query",
        "query_time",
        "status",
        "dataset_versions",
        "scope",
        "list_published_at",
        "candidate_count",
        "truncated",
        "limitations"
      ],
      "type": "object"
    },
    "SearchStatus": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Text": {
      "maxLength": 200000,
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:context:ScreeningExecution:2.0.0",
  "$ref": "#/$defs/ScreeningExecution",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
