{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "Transaction": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Decimal"
        },
        "country": {
          "$ref": "#/$defs/Id"
        },
        "currency": {
          "$ref": "#/$defs/Id"
        },
        "event_id": {
          "$ref": "#/$defs/Id"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "source": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/TransactionStatus"
        },
        "target": {
          "$ref": "#/$defs/Id"
        },
        "timestamp": {
          "$ref": "#/$defs/Timestamp"
        },
        "transaction_type": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "source",
        "target",
        "amount",
        "currency",
        "timestamp",
        "event_id",
        "status"
      ],
      "type": "object"
    },
    "TransactionStatus": {
      "enum": [
        "settled",
        "pending",
        "reversed",
        "cancelled"
      ]
    }
  },
  "$id": "urn:financial-crime:context:Transaction:2.0.0",
  "$ref": "#/$defs/Transaction",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
