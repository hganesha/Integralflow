{
  "$defs": {
    "Bool": {
      "type": "boolean"
    },
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "GraphScope": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "max_depth": {
          "$ref": "#/$defs/Count"
        },
        "max_edges": {
          "$ref": "#/$defs/Count"
        },
        "roots": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "roots",
        "max_depth",
        "max_edges",
        "as_of_time"
      ],
      "type": "object"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "NetworkGraph": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "$ref": "#/$defs/Bool"
        },
        "edge_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 10000,
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/GraphScope"
        }
      },
      "required": [
        "nodes",
        "edge_refs",
        "scope",
        "complete"
      ],
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:context:NetworkGraph:2.0.0",
  "$ref": "#/$defs/NetworkGraph",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
