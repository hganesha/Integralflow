{
  "$defs": {
    "Decimal": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "Extension": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Semver"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "schema_version",
        "value"
      ],
      "type": "object"
    },
    "Extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/Extension"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object",
      "x-dynamic-map-reason": "explicit versioned source/institution extensions"
    },
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "MissingBehavior": {
      "enum": [
        "UNKNOWN",
        "BLOCKED",
        "NEEDS_EVIDENCE"
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "object_type": {
          "$ref": "#/$defs/Id"
        },
        "schema_version": {
          "$ref": "#/$defs/Semver",
          "default": "2.0.0"
        },
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "version_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "tenant_id",
        "object_type",
        "object_id",
        "version_id"
      ],
      "type": "object"
    },
    "RiskModel": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "factor_weights": {
          "additionalProperties": {
            "$ref": "#/$defs/Decimal"
          },
          "type": "object",
          "x-dynamic-map-reason": "keyed collection"
        },
        "missing_factor_behavior": {
          "$ref": "#/$defs/MissingBehavior"
        },
        "model_version": {
          "$ref": "#/$defs/Id"
        },
        "tiers": {
          "items": {
            "$ref": "#/$defs/RiskTier"
          },
          "maxItems": 10000,
          "type": "array"
        }
      },
      "required": [
        "model_version",
        "factor_weights",
        "tiers",
        "missing_factor_behavior"
      ],
      "type": "object"
    },
    "RiskTier": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/Decimal"
        },
        "tier": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "minimum",
        "tier"
      ],
      "type": "object"
    },
    "Semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "urn:financial-crime:context:RiskModel:2.0.0",
  "$ref": "#/$defs/RiskModel",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
