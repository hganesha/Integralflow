{
  "$defs": {
    "Id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxItems": 10000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object",
          "x-dynamic-map-reason": "raw JSON source value"
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/RuleLeaf"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "any": {
              "items": {
                "$ref": "#/$defs/Predicate"
              },
              "maxItems": 100,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "any"
          ],
          "type": "object"
        }
      ]
    },
    "RuleLeaf": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/Id"
        },
        "op": {
          "$ref": "#/$defs/RuleOperator"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "type": "object"
    },
    "RuleOperator": {
      "enum": [
        "eq",
        "ne",
        "in",
        "contains",
        "excludes",
        "gte",
        "gt",
        "lte",
        "lt",
        "present"
      ]
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Bindings",
          "type": "object",
          "x-dynamic-map-reason": "typed keyed runtime values; business payloads are validated by their selected skill contract"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object",
          "x-dynamic-map-reason": "typed keyed runtime values; business payloads are validated by their selected skill contract"
        },
        "skill_id": {
          "title": "Skill Id",
          "type": "string"
        },
        "success_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "skill_id"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "version": {
      "default": "0.5.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "steps"
  ],
  "title": "Workflow",
  "type": "object"
}
